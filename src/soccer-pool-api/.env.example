# ── Server ─────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ── Database (Docker) ──────────────────────────────────────────
# Compose these values to build DATABASE_URL
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Email ──────────────────────────────────────────────────────
# Use "maildev" for local development, "resend" for production
EMAIL_PROVIDER="maildev"

# MailDev (local only — docker compose)
MAILDEV_HOST="localhost"
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=1080

# Resend (production)
RESEND_API_KEY=""

# ── Auth (Google OAuth — future spec) ─────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Football API ───────────────────────────────────────────────
FOOTBALL_API_KEY=""

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────
WA_TOKEN=""
WA_PHONE_ID=""
WA_VERIFY_TOKEN=""
